{
  "id": "china_mobile_sub",
  "name": "中国移动网厅余量查询",
  "author": "@Antigravity",
  "icon": "https://raw.githubusercontent.com/Orz-3/mini/master/Alpha/10086.png",
  "repo": "https://github.com/tianhongsw/loon",
  "apps": [
    {
      "id": "china_mobile",
      "name": "中国移动（官方网厅免登录版）",
      "keys": [
        "china_mobile_cookie",
        "MCLD_COOKIES",
        "china_mobile_phonenumber",
        "china_mobile_bark_key",
        "china_mobile_silent",
        "china_mobile_cache"
      ],
      "author": "@Antigravity",
      "icon": "https://raw.githubusercontent.com/Orz-3/mini/master/Alpha/10086.png",
      "icons": [
        "https://raw.githubusercontent.com/Orz-3/mini/master/Alpha/10086.png",
        "https://raw.githubusercontent.com/Orz-3/mini/master/Alpha/10086.png"
      ],
      "repo": "https://github.com/tianhongsw/loon",
      "descs_html": [
        "1. 依托移动云盘 SSO 跳板，全自动签发大网网关会话，免抓包、免登录",
        "2. 在下方【移动云盘根凭据】填入 Basic 开头的 Authorization 凭据",
        "3. 支持多账号（一行一个或填入 MCLD_COOKIES），多卡自动轮询",
        "4. 支持云盘根凭据临期（≤7天）官方接口全自动顺延 30 天，永不掉线",
        "5. 点击下方「点击运行」即可实时查询话费、通用流量与通话余量"
      ],
      "settings": [
        {
          "id": "china_mobile_cookie",
          "name": "移动云盘根凭据 (Token)",
          "val": "",
          "type": "textarea",
          "autoGrow": true,
          "rows": 3,
          "desc": "填入移动云盘 Authorization 凭据（以 Basic 开头）。支持多账号，一行一个；或手机号#凭据"
        },
        {
          "id": "china_mobile_phonenumber",
          "name": "手机号码（选填）",
          "val": "",
          "type": "text",
          "desc": "单账号时可选填手机号；留空则全自动从凭据中解析手机号"
        },
        {
          "id": "china_mobile_bark_key",
          "name": "Bark 通知 Key（选填）",
          "val": "",
          "type": "text",
          "desc": "iOS Bark App 推送 Key，填入后将触发独立 Bark 消息推送"
        },
        {
          "id": "china_mobile_silent",
          "name": "静默运行",
          "val": false,
          "type": "boolean",
          "desc": "开启后不弹出横幅通知，仅在日志中输出"
        }
      ],
      "scripts": [
        {
          "name": "查询话费流量语音",
          "script": "https://raw.githubusercontent.com/tianhongsw/loon/main/10086.js"
        }
      ]
    }
  ]
}
